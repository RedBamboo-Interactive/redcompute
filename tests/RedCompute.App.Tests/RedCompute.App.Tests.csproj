<Project Sdk="Microsoft.NET.Sdk">
  <!-- Follows the host it tests (LeafTargetOs, see Directory.Build.props). -->
  <PropertyGroup Condition="'$(LeafTargetOs)' == 'windows'">
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LeafTargetOs)' == 'linux'">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\..\src\RedCompute.App\RedCompute.App.csproj" />
    <!-- Not used by RedCompute yet: referenced so the IL guard scans the node link and the node agent too. -->
    <ProjectReference Include="..\..\src\RedCompute.NodeLink\RedCompute.NodeLink.csproj" />
    <ProjectReference Include="..\..\src\RedCompute.Node\RedCompute.Node.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.ClaudeCode\RedCompute.Plugin.ClaudeCode.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.Codex\RedCompute.Plugin.Codex.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.OpenCode\RedCompute.Plugin.OpenCode.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.Suno\RedCompute.Plugin.Suno.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.ComfyUI\RedCompute.Plugin.ComfyUI.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.Kev\RedCompute.Plugin.Kev.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.LocalWsl\RedCompute.Plugin.LocalWsl.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.SttLocal\RedCompute.Plugin.SttLocal.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.DiarizationLocal\RedCompute.Plugin.DiarizationLocal.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.OpenAILive\RedCompute.Plugin.OpenAILive.csproj" />
    <!-- Not used by a test directly: the execution-host guard scans every plugin's IL. -->
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.TtsLocal\RedCompute.Plugin.TtsLocal.csproj" />
    <ProjectReference Include="..\..\plugins\RedCompute.Plugin.TtsElevenLabs\RedCompute.Plugin.TtsElevenLabs.csproj" />
    <!-- Stand-in CLI for the launch goldens; its apphost is copied beside the tests. -->
    <ProjectReference Include="..\RedCompute.TestProbe\RedCompute.TestProbe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The link harness's seeded fault proxy, shared with the NodeLink tests: NodeLinkEndToEndTests runs the
         real agent against NodeHub through it. -->
    <Compile Include="..\RedCompute.NodeLink.Tests\LinkFaultProxy.cs" Link="Shared\LinkFaultProxy.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\rebuild.ps1" Link="rebuild.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\deploy-staged.ps1" Link="deploy-staged.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Fixtures\**\*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Fixtures\vision\*" LinkBase="Fixtures\vision">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Fixtures\artifact-extraction-cases.json" Link="Fixtures\artifact-extraction-cases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Platform-aware test attributes and stand-in processes, shared by every test project. -->
    <Compile Include="..\Shared\PlatformFacts.cs" Link="Shared\PlatformFacts.cs" />
    <Compile Include="..\Shared\LaunchGoldens.cs" Link="Shared\LaunchGoldens.cs" />
    <Using Include="RedCompute.Tests" />
  </ItemGroup>
</Project>
