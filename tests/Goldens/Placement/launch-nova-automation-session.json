{
  "argumentList": [
    "--print",
    "# Automation: Nightly review",
    "--output-format",
    "stream-json",
    "--verbose",
    "--include-partial-messages",
    "--max-turns",
    "50",
    "--permission-mode",
    "auto",
    "--append-system-prompt",
    "Permissions: this session runs at Auto. Nobody watches it, so anything that needs approval is denied at once. A denied tool or command without a reason was denied for that. Approval requires a signed-in person in an interactive session. Continue without it.",
    "--strict-mcp-config",
    "--mcp-config",
    "{\"mcpServers\":{}}",
    "--thinking-display",
    "summarized",
    "--allowed-tools",
    "Read,Write,Edit,Glob,Grep",
    "--add-dir",
    "<root>\\scratch"
  ],
  "containment": "session:claude-code-agent",
  "createNoWindow": true,
  "encoding": {
    "stderr": "utf-8/preamble=3",
    "stdin": "utf-8/preamble=0",
    "stdout": "utf-8/preamble=3"
  },
  "environmentChanges": {
    "REDLEAF_SCRATCH_DIR": "<root>\\scratch",
    "REDLEAF_SCRATCH_ROOT": "<root>\\scratch",
    "TEMP": "<root>\\scratch",
    "TMP": "<root>\\scratch",
    "TMPDIR": "<root>\\scratch"
  },
  "environmentTouched": true,
  "fileName": "<root>\\cli\\claude.exe",
  "redirect": {
    "stderr": true,
    "stdin": true,
    "stdout": true
  },
  "seam": "claude.LaunchAgentProcess",
  "useShellExecute": false,
  "workingDirectory": "<root>\\workspace"
}
