{
  "argumentList": [
    "app-server"
  ],
  "containment": "session:codex",
  "createNoWindow": true,
  "encoding": {
    "stderr": "utf-8/preamble=3",
    "stdin": "utf-8/preamble=0",
    "stdout": "utf-8/preamble=3"
  },
  "environmentChanges": {
    "REDLEAF_EXECUTION_TOKEN": "golden-execution-token",
    "REDLEAF_SCRATCH_DIR": "<root>\\scratch",
    "REDLEAF_SCRATCH_ROOT": "<root>\\scratch",
    "TEMP": "<root>\\scratch",
    "TMP": "<root>\\scratch",
    "TMPDIR": "<root>\\scratch"
  },
  "environmentTouched": true,
  "fileName": "<root>\\cli\\codex.exe",
  "redirect": {
    "stderr": true,
    "stdin": true,
    "stdout": true
  },
  "seam": "codex.LaunchAppServerProcess",
  "useShellExecute": false,
  "workingDirectory": "<root>\\project"
}
