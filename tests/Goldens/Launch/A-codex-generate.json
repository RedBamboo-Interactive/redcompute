{
  "argumentList": [
    "exec",
    "-",
    "--json",
    "--skip-git-repo-check",
    "--sandbox",
    "read-only",
    "-c",
    "model_reasoning_effort=\"low\"",
    "--model",
    "gpt-golden"
  ],
  "containment": "session:codex-exec",
  "createNoWindow": true,
  "encoding": {
    "stderr": "utf-8/preamble=3",
    "stdin": "utf-8/preamble=0",
    "stdout": "utf-8/preamble=3"
  },
  "environmentTouched": false,
  "fileName": "<root>\\cli\\codex.exe",
  "redirect": {
    "stderr": true,
    "stdin": true,
    "stdout": true
  },
  "seam": "codex.LaunchExecProcess",
  "useShellExecute": false,
  "workingDirectory": "<isolated-cwd>"
}
