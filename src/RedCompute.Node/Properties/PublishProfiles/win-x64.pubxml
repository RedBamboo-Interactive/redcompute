<?xml version="1.0" encoding="utf-8"?>
<!--
  leaf-node win-x64 (Phase 3 design 2.3, 2.4; R7): self-contained and untrimmed, one folder that runs
  without a .NET install. The release recipe, release/leaf-node/Build-LeafNodeArtifacts.ps1, restores
  in locked mode and publishes with this profile, the Nightly's version and the deterministic CI
  properties, then archives the folder with "RedCompute.ReleaseTool node archive".

  Name the runtime on the command line as well (dotnet publish -r win-x64 -p:PublishProfile=win-x64):
  the profile is read after Directory.Build.props, which picks the lock file (packages.lock.json or
  packages.linux.lock.json) from the runtime identifier given there.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
