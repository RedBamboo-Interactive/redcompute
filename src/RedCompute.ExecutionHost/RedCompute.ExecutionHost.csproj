<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The execution host: IExecutionHost (paths, files, processes, containment, hardware, network of
    one machine) and node zero's LocalExecutionHost. Split out of RedCompute.PluginSdk so the node
    agent (RedCompute.Node) runs the same host code without ASP.NET Core or the plugin SDK. The
    namespaces stay RedCompute.PluginSdk.Hosting(.Local) and RedCompute.PluginSdk (PlatformSupport);
    RedCompute.PluginSdk forwards the moved types, so plugins built against it keep loading.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RedCompute.PluginSdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedCompute.Core\RedCompute.Core.csproj" />
    <!--
      The local host's QuerySqliteReadOnly. Compile-only: RedCompute and the plugins that read SQLite
      already carry this version (Microsoft.EntityFrameworkCore.Sqlite 9.0.18), and the host's consumers
      gain no package from it.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.18" PrivateAssets="all" />
    <!--
      The local host's per-process VRAM on Windows ("GPU Process Memory" counters). Compile-only, like
      SQLite above: RedCompute already carries this version, and the host's consumers gain no package.
    -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launch goldens capture where the local execution host hands a start info to the OS. -->
    <InternalsVisibleTo Include="RedCompute.App.Tests" />
    <InternalsVisibleTo Include="RedCompute.Plugin.Codex.Tests" />
  </ItemGroup>

</Project>
